# Telegram Bot
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789,987654321

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/bot_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bot_db
DB_USER=botuser
DB_PASSWORD=strongpassword

# Google Vertex AI
GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_LOCATION=us-central1

# Credentials — IKKISIDAN BIRI YETARLI:
# 1-usul (tavsiya): JSON mazmunini to'g'ridan-to'g'ri env ga qo'yish
#   (Docker, Railway, Cloud Run uchun qulay — fayl kerak emas)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# 2-usul: fayl yo'li (lokal ishlab chiqish uchun qulay)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

VERTEX_EMBEDDING_MODEL=text-multilingual-embedding-002
VERTEX_CHAT_MODEL=gemini-1.5-flash-002

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379

# Admin Panel
ADMIN_PANEL_HOST=0.0.0.0
ADMIN_PANEL_PORT=8000
SECRET_KEY=your-very-secret-key-change-this
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Bot settings
MAX_WARNINGS=3
MUTE_DURATION_MINUTES=60
DELETE_JOIN_LEAVE_MESSAGES=true
